# GraphOne / FrontierAtlas Ingestion Pipeline Environment Variables

# LLM Providers (Optional: system uses local fallback parser if keys are not provided)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub API Token (Optional: enhances rate limit for star metrics scraping)
GITHUB_TOKEN=

# Crawling Configuration
MAX_CONCURRENT_REQUESTS=20
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
